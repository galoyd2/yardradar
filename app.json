{
  "expo": {
    "name": "YardRadar",
    "slug": "yardradar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90E2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A90E2"
      },
      "package": "com.yardradar.app",
      "versionCode": 3,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBoWnaG30UR-6ztRcr5jOcg8uvYk5GzVlo"
        }
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bd926441-debb-41e2-bccb-4d8c8bf6c85d"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4A90E2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "YardRadar needs access to your photos so you can add pictures to your sale.",
          "cameraPermission": "YardRadar needs camera access so you can take pictures for your sale."
        }
      ]
    ]
  }
}
